# ============================================================
# Co-Eco-Graph environment configuration
# Copy this file to .env and fill in the values.
# ============================================================

# --- AI (optional) ---
# App works without AI — subgraph discovery and graph still function.
# Get credentials: https://developers.cloudflare.com/workers-ai/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# --- The Graph (required for discovery) ---
# Get API key: https://thegraph.com/en/
THEGRAPH_API_KEY=
THEGRAPH_GATEWAY_URL=https://gateway.thegraph.com/api
GRAPH_NETWORK_SUBGRAPH_ID=QmdKXcBUHR3UyURqVRQHu1oV6VUkBrhi2vNvMx3bNDnUCc

# --- IPFS (optional, defaults work) ---
IPFS_GATEWAY_URL=https://ipfs.thegraph.com/ipfs
SUBGRAPH_MANIFEST_CACHE_TTL=3600

# --- Local dev server ---
PORT=3001
TOP_SUBGRAPHS=5
