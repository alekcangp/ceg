# ============================================================
# Co-Eco-Graph environment configuration
# ============================================================
# All other tunables (models, gateways,
# subgraph id, limits) have working defaults in `src/config.ts` —
# edit that file (or set env vars to override) if needed.
# ============================================================

# The Graph API key (required for discovery)
# Get API key: https://thegraph.com/en/
THEGRAPH_API_KEY=

# Pollinations API key (optional — public tier works without it)
# Get API key: https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=
