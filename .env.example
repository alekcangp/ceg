# ============================================================
# Co-Eco-Graph environment configuration
# Copy this file to .env and fill in the values.
# ============================================================

# ============================================================
# Pollinations AI (text + image generation)
# Docs: https://gen.pollinations.ai/docs
# Get API key: https://enter.pollinations.ai/keys
# ============================================================

# --- Text generation (POST /v1/chat/completions) ---
# Model is required for text generation. Available models:
#   openai/gpt-5.4-nano, openai/gpt-5-nano, google/gemini-3.7-flash,
#   deepseek/deepseek-v4-flash, anthropic/claude-sonnet-4.6, etc.
# Full list: https://gen.pollinations.ai/v1/models
POLLINATIONS_MODEL=openai/gpt-5.4-nano

# --- Image generation (GET /image/{prompt}) ---
# Model is required for image generation. Available models:
#   black-forest-labs/flux.1-schnell, openai/gpt-image-1-mini,
#   bytedance/seedream-5.0-lite, google/gemini-3.1-flash-image, etc.
POLLINATIONS_MODEL_IMAGE=

# --- Auth (required for both text and image) ---
POLLINATIONS_API_KEY=

# --- Optional ---
#POLLINATIONS_BASE_URL=https://gen.pollinations.ai

# --- The Graph (required for discovery) ---
# Get API key: https://thegraph.com/en/
THEGRAPH_API_KEY=
GRAPH_NETWORK_SUBGRAPH_ID=QmdKXcBUHR3UyURqVRQHu1oV6VUkBrhi2vNvMx3bNDnUCc

# --- IPFS (optional, defaults work) ---
IPFS_GATEWAY_URL=https://ipfs.thegraph.com/ipfs

# --- Local dev ---
# Frontend: http://localhost:5173 (Vite dev server)
# API:      http://localhost:3001/api/analyze (run with `npm run dev:api`)
TOP_SUBGRAPHS=5
