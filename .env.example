# ============================================================
# Co-Eco-Graph environment configuration
# Copy this file to .env and fill in the values.
# ============================================================

# --- Primary AI backend: OpenRouter (OpenAI-compatible, free :free models available) ---
# Get API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free
#OPENROUTER_MAX_TOKENS=8000

# --- Secondary AI backend: Kilo Gateway (free ":free" models, OpenAI-compatible,
# ~200 requests/hour per IP, no API key required for :free models) ---
# Benchmark (Sep 2026, tiny JSON task, 1 run each, from live gateway):
#   nex-agi/nex-n2.5-mini:free  ~1-2s  valid JSON  <- OPTIMAL (fast + correct)
#   nex-agi/nex-n2.5-pro:free   ~4-9s  valid JSON  <- runner-up (slower, stable)
#   kilo-auto/free              ~9-14s empty/reasoning-only (unstable router)
#   rest: 429 rate-limited, empty, or thinking-dump instead of JSON
# KILO_MODEL=nex-agi/nex-n2.5-mini:free
# KILO_API_KEY=
#KILO_MAX_TOKENS=8000

# --- Fallback: Cloudflare Workers AI (10,000 free neurons/day, resets 00:00 UTC) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# --- The Graph (required for discovery) ---
# Get API key: https://thegraph.com/en/
THEGRAPH_API_KEY=
GRAPH_NETWORK_SUBGRAPH_ID=QmdKXcBUHR3UyURqVRQHu1oV6VUkBrhi2vNvMx3bNDnUCc

# --- IPFS (optional, defaults work) ---
IPFS_GATEWAY_URL=https://ipfs.thegraph.com/ipfs

# --- Local dev ---
# Frontend: http://localhost:5173 (Vite dev server)
# API:      http://localhost:3001/api/analyze (run with `npm run dev:api`)
TOP_SUBGRAPHS=5
